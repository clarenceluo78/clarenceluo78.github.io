---
layout: null
permalink: /blog/feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.blog.title | xml_escape }}</title>
  <subtitle>{{ site.blog.intro | xml_escape }}</subtitle>
  <link href="{{ '/blog/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/blog/' | absolute_url }}"/>
  <id>{{ '/blog/' | absolute_url }}</id>
  <updated>{% if site.posts.first %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.data.main_info.name | xml_escape }}</name></author>
  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</updated>
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
