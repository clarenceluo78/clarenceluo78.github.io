---
layout: null
permalink: /blog/search-index.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "dateLabel": "{{ post.date | date: '%B %-d, %Y' }}",
    "tags": {{ post.tags | default: empty | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | truncatewords: site.blog.excerpt_words | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
